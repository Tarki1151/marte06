rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is an admin via Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public assets (logo, etc.)
    match /settings/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // GymEntra multi-tenant logos: public read (the join-by-code screen shows
    // a gym's logo before any membership exists), and **no client write at
    // all** — the `uploadTenantLogo` callable writes these with the Admin SDK
    // after checking membership in code.
    //
    // This used to be a cross-service rule that read `tenant_memberships`
    // from here. Three things made that the wrong foundation: it fails closed
    // and silent (the client only ever sees `storage/unauthorized`, never
    // that a Firestore lookup inside a rule was what failed); it needs an IAM
    // grant that `firebase deploy` does not make, so a correct rule can still
    // deny everyone; and it had been broken since the singular `role` field
    // was dropped on 27 Aug 2026 without anyone noticing, because the only
    // account that tested it carried the legacy global `admin` claim and
    // passed through the other branch. A real gym owner has no such claim.
    match /tenant-logos/{tenantId} {
      allow read: if true;
      allow write: if false;
    }

    // Member-specific files (future: profile photos, documents)
    match /members/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin()) &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    // Default: only admins can access other paths
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
