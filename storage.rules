rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is an admin via Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public assets (logo, etc.)
    match /settings/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // GymEntra multi-tenant logos: public read (shown in-app to every
    // member), write restricted to that tenant's active admin — checked
    // against the same tenant_memberships doc the Firestore rules use.
    // Reads `roles`, not the singular `role`. The old field was dropped from
    // every membership on 27 Aug 2026 (drop_legacy_role_field.cjs) and this
    // rule was missed, so it had been comparing against a field that no
    // longer exists — every logo upload failed with permission-denied and
    // nothing pointed at the rule.
    function isGymEntraTenantAdmin(tenantId) {
      let membershipPath = /databases/(default)/documents/tenant_memberships/$(tenantId + '_' + request.auth.uid);
      return request.auth != null &&
        firestore.exists(membershipPath) &&
        'admin' in firestore.get(membershipPath).data.roles &&
        firestore.get(membershipPath).data.status == 'active';
    }
    match /tenant-logos/{tenantId} {
      allow read: if true;
      allow write: if (isAdmin() || isGymEntraTenantAdmin(tenantId)) &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    // Member-specific files (future: profile photos, documents)
    match /members/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin()) &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    // Default: only admins can access other paths
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
